# ============================================================
# Liberty Quest Content Engine — Environment Variables
# Copy this file to .env.local for local development
# Add these to Railway environment variables for production
# ============================================================

# --- Database (Railway PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/liberty_quest

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Facebook Graph API ---
# Get from: developers.facebook.com → Your App → Tools → Graph API Explorer
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_token_here

# --- App Security ---
# Random string to protect cron endpoints from unauthorized calls
CRON_SECRET=change-this-to-a-random-string-min-32-chars

# --- App URL (used for internal API calls from cron) ---
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# --- Images: DALL-E 3 (illustrated posts) ---
# Uses your existing OPENAI_API_KEY — no extra setup

# --- Images: Unsplash (historical posts) ---
# Free account at unsplash.com/developers → New Application
# Copy "Access Key" (not Secret Key)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Images: Cloudinary storage (permanent URLs) ---
# Free account at cloudinary.com
# Dashboard → Settings → Upload → Upload presets → Add preset → Unsigned
# Cloud name is on your Cloudinary dashboard home page
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=liberty-quest-unsigned
